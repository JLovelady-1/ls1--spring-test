        numTrimPreload.ValueChanged += (_, _) => UpdateSpecLabel();
        chkAutoPreload.CheckedChanged += (_, _) => UpdateSpecLabel();
        numP2.ValueChanged += (_, _) => UpdateSpecLabel();

        btnTare.Click += async (_, _) => await TareAsync();
        btnPreload.Click += async (_, _) => await PreloadAsync();
        btnRun.Click += async (_, _) => await RunAsync();

        btnZeroF.Click += async (_, _) => { if (_ctl != null) { await _ctl.TareForceAsync(); ResetSteps(); } };
        btnZeroP.Click += async (_, _) => { if (_ctl != null) { await _ctl.ZeroPositionAsync(); _preloaded = false; UpdateEnables(); } };
        HookJog(btnJogExt, JogDirection.Extend, false);
