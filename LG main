        Dock = DockStyle.Fill,
        BackColor = InputBg,
        ForeColor = Text1,
        BorderStyle = BorderStyle.FixedSingle,
        TextAlign = HorizontalAlignment.Right,
        Margin = new Padding(3),
    };
