    private void UiTick()
    {
        bool online = _ctl != null;
        lblConn.Text = online ? (_machine is SimulatedLsMachine ? "● SIMULATOR" : "● LS1+  ONLINE") : "● LS1+  OFFLINE";
        lblConn.ForeColor = online ? GOOD : TEXT_DIM;
        if (_ctl == null) return;

        var r = _ctl.Latest;
        double lbf = r.ForceN * SpringSpec.N_TO_LBS;
        lblLoad.Text = $"{lbf:0.0000}";
        lblLoadN.Text = $"{r.ForceN:0.0000} N";
        lblPos.Text = $"{r.PositionIn:0.0000} in";
        lblPosMm.Text = $"{r.PositionIn * 25.4:0.000} mm";
        _speedSamples.Enqueue((r.Time, r.PositionIn));
        while (_speedSamples.Count > 2 && (r.Time - _speedSamples.Peek().t).TotalSeconds > 1.0) _speedSamples.Dequeue();
        var s0 = _speedSamples.Peek();
        double sdt = (r.Time - s0.t).TotalSeconds;
        lblSpeed.Text = sdt > 0.3 ? $"{Math.Abs(r.PositionIn - s0.p) / sdt * 60 * 25.4:0.0} mm/min" : "";

        string? op = _ctl.ActiveOperation;
        if (op != null) { lblMotion.Text = "● " + op.ToUpperInvariant(); lblMotion.ForeColor = AMBER; }
        else if (r.IsMoving) { lblMotion.Text = "● MOVING"; lblMotion.ForeColor = AMBER; }
        else { lblMotion.Text = "● STOPPED"; lblMotion.ForeColor = TEXT_DIM; }
        lblHz.Text = $"{_ctl.ReadingsHz:0} Hz";

        // colour the hero value against the pass band while a test is in progress
        var spec = SelectedSpec;
        lblLoad.ForeColor = op != null ? AMBER : INK;

        _loadHistory.Enqueue(lbf);
        while (_loadHistory.Count > CHART_POINTS) _loadHistory.Dequeue();
        chart.Invalidate();
    }

    private void Chart_Paint(object? sender, PaintEventArgs e)
    {
        var g = e.Graphics;
        int w = chart.Width, h = chart.Height;
        g.Clear(CARD);
        g.SmoothingMode = SmoothingMode.AntiAlias;

        using var gridPen = new Pen(Color.FromArgb(42, 45, 52), 1);
        for (int i = 1; i < 4; i++) { int gy = h * i / 4; g.DrawLine(gridPen, 0, gy, w, gy); }
        for (int i = 1; i < 6; i++) { int gx = w * i / 6; g.DrawLine(gridPen, gx, 0, gx, h); }
        if (_loadHistory.Count < 2 || h < 20) return;

        var pts = _loadHistory.ToArray();
        double min = Math.Min(0, pts.Min()), max = pts.Max();
        var spec = SelectedSpec;
        bool showBand = false;   // pass/fail is on rate, not on a load band
        if (showBand) max = Math.Max(max, spec!.LoadMaxLbf * 1.08);
        if (max - min < 0.001) max = min + 0.001;
        float Y(double v) => h - (float)((v - min) / (max - min) * (h - 8)) - 4;

        if (showBand)
        {
            float y1 = Y(spec!.LoadMaxLbf), y2 = Y(spec.LoadMinLbf);
            using var band = new SolidBrush(Color.FromArgb(28, GOOD));
            g.FillRectangle(band, 0, y1, w, y2 - y1);
            using var bandPen = new Pen(Color.FromArgb(90, GOOD), 1) { DashStyle = DashStyle.Dash };
            g.DrawLine(bandPen, 0, y1, w, y1);
            g.DrawLine(bandPen, 0, y2, w, y2);
        }

        using (var font = new Font("Consolas", 7f))
        using (var brush = new SolidBrush(TEXT_DIM))
        {
            for (int i = 1; i < 4; i++)
            {
                double val = min + (max - min) * i / 4.0;
                g.DrawString($"{val:0.000}", font, brush, 3, Y(val) - 12);
            }
        }

        float xStep = (float)w / (CHART_POINTS - 1);
        var points = new PointF[pts.Length];
        for (int i = 0; i < pts.Length; i++)
            points[i] = new PointF((i + CHART_POINTS - pts.Length) * xStep, Y(pts[i]));
        using var linePen = new Pen(Color.FromArgb(210, 214, 220), 1.6f);
        g.DrawLines(linePen, points);
        var last = points[^1];
        using var dot = new SolidBrush(WHITE);
        g.FillEllipse(dot, last.X - 3, last.Y - 3, 6, 6);
    }

    /// <summary>Shrink the big PASS/FAIL text and the detail text until they fit their boxes.</summary>
    private void FitResultText()
    {
        FitLabel(lblResult, "Segoe UI Light", 60f, 14f, FontStyle.Regular);
        FitLabel(lblResultDetail, "Consolas", 11f, 7f, FontStyle.Regular);
    }

    private static void FitLabel(Label l, string family, float maxPt, float minPt, FontStyle style)
    {
        if (l.Width < 10 || l.Height < 10) return;
        var box = new Size(l.Width - 8, l.Height - 4);
        for (float pt = maxPt; pt >= minPt; pt -= 1f)
        {
            using var f = new Font(family, pt, style);
            var sz = TextRenderer.MeasureText(string.IsNullOrEmpty(l.Text) ? "X" : l.Text, f,
                                              new Size(int.MaxValue, int.MaxValue), TextFormatFlags.NoPadding);
            if ((sz.Width <= box.Width && sz.Height <= box.Height) || pt <= minPt)
            {
                if (l.Font.Size != pt || l.Font.FontFamily.Name != family) l.Font = new Font(family, pt, style);
                return;
            }
        }
    }

