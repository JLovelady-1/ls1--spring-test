    private async Task ConnectAsync()
    {
        if (_ctl != null) return;
        try
        {
            _machine = cboMode.SelectedIndex == 1
                ? new LsSerialMachine(cboPort.Text, cboPortRead.Text)
                : new SimulatedLsMachine();
            if (_machine is SimulatedLsMachine sim && SelectedSpec is { } spec) sim.LoadSpring(spec);

            PullSettings();
            var ctl = new MachineController(_machine, _settings);
            ctl.StatusChanged += m => Ui(() => SetStatus(m));
            ctl.BusyChanged += _ => Ui(UpdateEnables);
            SetStatus("Connecting…");
            await ctl.ConnectAsync();

            _ctl = ctl;
            ResetSteps();
            SetStatus(cboMode.SelectedIndex == 1
                ? $"LS1+ connected — control {cboPort.Text}, readings {cboPortRead.Text}."
                : "Simulator connected.");
            ShowPage(0);
        }
        catch (Exception ex)
        {
            SetStatus($"Connect failed: {ex.Message}");
            try { _machine?.Dispose(); } catch { }
            _machine = null;
            _ctl = null;
        }
        finally
        {
            UpdateEnables();
        }
    }

    private async Task DisconnectAsync()
    {
        var old = _ctl;
        if (old == null) return;
        _ctl = null;
        try { await old.DisconnectAsync(); } catch { }
        old.Dispose();
        _machine = null;
        ResetSteps();
        UpdateEnables();
    }

    private async Task TareAsync()
    {
        if (_ctl == null) return;
        if (await _ctl.ZeroAllAsync()) { _tared = true; _preloaded = false; }
        UpdateEnables();
    }

    private async Task PreloadAsync()
    {
        if (_ctl == null) return;
        PullSettings();
        _preloaded = await _ctl.FindPreloadAsync();
        UpdateEnables();
    }

    private async Task RunAsync()
    {
        if (_ctl == null || SelectedSpec is not { } spec) return;
        PullSettings();
        ShowRunning(spec);
        var r = await _ctl.RunSequenceAsync(spec, (double)numFree.Value);
        if (r is null)
        {
            ShowIdle("Test aborted — see event log");
        }
        else
        {
            _lastResult = r;
            ShowResult(r);
            _results.Add(r);
            AddGridRow(r);
            _tared = false;         // next spring must be tared again
            _preloaded = false;
            UpdateEnables();
            if (chkAutoReturn.Checked) await ReturnAsync();   // drive back to the RETURN TO position
        }
        UpdateEnables();
    }

    private async Task StopAsync()
    {
        if (_ctl != null) await _ctl.StopAsync("STOP");
    }

    private async Task ReturnAsync()
    {
        if (_ctl == null) return;
        PullSettings();
        await _ctl.ReturnToZeroAsync();
    }

    private void OnFormClosing(object? sender, FormClosingEventArgs e)
    {
        _uiTimer.Stop();
        var ctl = _ctl;
        _ctl = null;
        if (ctl == null) return;
        try { ctl.Dispose(); } catch { }
    }

