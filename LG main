    private static TableLayoutPanel Grid(int cols, int rows) => new()
    {
        Dock = DockStyle.Fill, ColumnCount = cols, RowCount = rows, BackColor = BG, Margin = new Padding(0), Padding = new Padding(0),
    };

    private static RoundedPanel Card(TableLayoutPanel parent, int row, string title, Color? fill = null, int radius = 12)
    {
        var c = new RoundedPanel { Dock = DockStyle.Fill, Margin = new Padding(0, 0, 0, 12), Radius = radius, Fill = fill ?? CARD };
        parent.Controls.Add(c, 0, row);
        if (title.Length > 0) Tiny(c, title).SetBounds(16, 14, 320, 16);
        return c;
    }

    private static Label Tiny(RoundedPanel parent, string text)
    {
        var l = new Label
        {
            Text = Spaced(text), AutoSize = false, BackColor = parent.Fill, ForeColor = TEXT_DIM,
            Font = new Font("Segoe UI", 7.5f, FontStyle.Bold), TextAlign = ContentAlignment.MiddleLeft,
        };
        parent.Controls.Add(l);
        return l;
    }

    private static void StyleLabel(Label l, RoundedPanel parent, Font font, Color fg, ContentAlignment align)
    {
        l.AutoSize = false;
        l.Font = font;
        l.ForeColor = fg;
        l.TextAlign = align;
        l.BackColor = Color.Transparent;
        parent.Controls.Add(l);
    }

