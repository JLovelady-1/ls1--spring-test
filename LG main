    private void ShowResult(TestResult r)
    {
        var fg = r.Pass ? GOOD : FAULT;
        _resultCard.SetColors(r.Pass ? GOOD_FILL : FAULT_FILL, r.Pass ? GOOD_EDGE : FAULT_EDGE);
        lblResult.Text = r.Pass ? "PASS" : "FAIL";
        lblResult.ForeColor = fg;
        string text;
        if (r.RateLbPerIn is double rate)
        {
            string tag = r.RatePass == true ? "✓" : (rate < r.Spec.RateMinLbPerIn ? "✗ LOW" : "✗ HIGH");
            double dev = (rate - r.Spec.RateLbPerIn) / r.Spec.RateLbPerIn * 100.0;
            text = $"{r.Spec.PartNumber}\n" +
                   $"RATE  {rate:0.000} lb/in  {tag}   ({dev:+0.0;-0.0}% of nominal {r.Spec.RateLbPerIn:0.000})\n" +
                   $"spec {r.Spec.RateMinLbPerIn:0.000} – {r.Spec.RateMaxLbPerIn:0.000} lb/in";
        }
        else text = $"{r.Spec.PartNumber}\nRate could not be computed";
        if (r.Points is { Count: > 1 } pts)
            text += "\n" + string.Join("    ", pts.Select((p, k) => $"{k + 1}: {p.ForceLbf:0.000} lbf @ {p.PositionIn:0.000} in"));
        lblResultDetail.Text = text;
        lblResultDetail.ForeColor = Blend(fg, INK, 0.4f);
        FitResultText();
    }

    private void AddGridRow(TestResult r)
    {
        var sp = r.Spec;
        string rateVal = r.RateLbPerIn is double rv ? rv.ToString("0.000") : "—";
        string dev = r.RateLbPerIn is double rd ? $"{(rd - sp.RateLbPerIn) / sp.RateLbPerIn * 100:+0.0;-0.0} %" : "—";
        int i = grid.Rows.Add(
            r.Time.ToString("HH:mm:ss"), sp.PartNumber, rateVal,
            sp.RateLbPerIn.ToString("0.000"), sp.RateMinLbPerIn.ToString("0.000"), sp.RateMaxLbPerIn.ToString("0.000"),
            dev, r.Pass ? "PASS" : "FAIL");
        var cell = grid.Rows[i].Cells[grid.Columns.Count - 1];
        cell.Style.ForeColor = r.Pass ? GOOD : FAULT;
        cell.Style.Font = new Font("Consolas", 9.5f, FontStyle.Bold);
        grid.Rows[i].Cells[2].Style.ForeColor = r.Pass ? GOOD : FAULT;
        try { grid.FirstDisplayedScrollingRowIndex = i; } catch (InvalidOperationException) { }
        UpdateTally();
    }

    private void UpdateTally()
    {
        int pass = _results.Count(r => r.Pass);
        lblTally.Text = _results.Count == 0 ? "" : $"{_results.Count} tested   ·   {pass} pass   ·   {_results.Count - pass} fail";
    }

    private void UpdateEnables()
    {
        bool conn = _ctl != null;
        bool busy = _ctl?.IsBusy ?? false;

        btnConnect.Enabled = !conn;
        btnDisconnect.Enabled = conn && !busy;
        cboMode.Enabled = !conn;
        cboPort.Enabled = cboPortRead.Enabled = !conn && cboMode.SelectedIndex == 1;

        btnMain.Enabled = btnTrim.Enabled = cboPart.Enabled = !busy;
        numFree.Enabled = btnNominal.Enabled = !busy && _unlocked;
        foreach (var c in _lockables) c.Enabled = _unlocked;
        btnLock.Text = _unlocked ? "🔓  LOCK" : "🔒  UNLOCK";
        btnLock.Style(_unlocked ? AMBER : CARD_HI, _unlocked ? AMBER : BORDER, _unlocked ? DARK_TEXT : TEXT_MID, _unlocked ? 0 : 1);

        btnTare.Enabled = conn && !busy;
        btnPreload.Enabled = conn && !busy;
        btnRun.Enabled = conn && !busy;
        StyleStep(btnTare, "1   ZERO", _tared, conn && !busy && !_tared);
        StyleStep(btnRun, "2   RUN TEST   (preload → 2 points → rate)", false, conn && !busy && _tared);

        lblHint.Text = !conn ? "Not connected — go to Setup and connect."
            : busy ? $"{_ctl!.ActiveOperation}…   (Esc or STOP to abort)"
            : !_tared ? "With the spring slack (lower hook loose), press ZERO — that's the start position. Then RUN TEST."
            : "RUN TEST: back to zero → up to preload → zero → 20% / 60% points → rate.";

        btnZeroF.Enabled = btnZeroP.Enabled = conn && !busy;

        // Never disabled while busy: jog buttons must always receive MouseUp,
        // STOP and RETURN must always be available.
        btnJogExt.Enabled = btnJogRet.Enabled = btnJogExtFast.Enabled = btnJogRetFast.Enabled = conn;
        btnStop.Enabled = btnReturn.Enabled = conn;
    }

    /// <summary>Done steps get a check and sage tint; the next step is the white primary pill.</summary>
    private static void StyleStep(RoundedButton b, string text, bool done, bool next)
    {
        b.Text = done ? "✓   " + text.Substring(4) : text;
        if (done) b.Style(GOOD_FILL, GOOD_EDGE, GOOD);
        else if (next) b.Style(ACCENT_FILL, ACCENT_FILL, DARK_TEXT, 0);
        else b.Style(CARD_HI, BORDER, TEXT_MID);
    }

    private void ResetSteps()
    {
        _tared = false;
        _preloaded = false;
        UpdateEnables();
    }

    private void PullSettings()
    {
        _settings.PreloadN = (double)numPreload.Value;
        _settings.AutoPreload = chkAutoPreload.Checked;
        _settings.TrimPreloadN = (double)numTrimPreload.Value;
        _settings.PreloadFromZero = chkFromZero.Checked;
        _settings.ApproachSpeedInPerMin = (double)numApproach.Value / TestSettings.MM_PER_IN;
        _settings.PreloadDwellSeconds = (double)numPreloadDwell.Value;
        _settings.TestSpeedInPerMin = (double)numSpeed.Value / TestSettings.MM_PER_IN;
        _settings.SettleSeconds = (double)numSettle.Value;
        _settings.ReturnFastMmMin = (double)numReturn.Value;
        _settings.ReturnTargetMm = (double)numReturnTo.Value;
        _settings.MaxPreloadSearchIn = (double)numSearch.Value / TestSettings.MM_PER_IN;
        _settings.RatePoint1Pct = (double)Math.Min(numP1.Value, numP2.Value - 5);
        _settings.RatePoint2Pct = (double)numP2.Value;
        _settings.ForceLimitN = (double)numForceLimit.Value;
        _settings.ZeroForceAtPreload = chkZeroForceAtPreload.Checked;
        _settings.UseJogMotion = cboMotion.SelectedIndex == 0;
        _settings.MaxAutoSpeedMmMin = (double)numMaxSpeed.Value;
        _settings.FastApproachZoneIn = (double)numSlowZone.Value / TestSettings.MM_PER_IN;
        _settings.TestFastApproach = chkFastTest.Checked;
        _settings.MeasureRate = true;
        _settings.PreloadUseJog = chkPreloadJog.Checked;
        if (_machine != null) _machine.KeepAliveDrives = chkKeepAlive.Checked;
    }

    private void PopulatePorts()
    {
        var ports = SerialPort.GetPortNames().Union(new[] { "COM4", "COM5" }).Distinct().OrderBy(p => p).ToArray();
        foreach (var cb in new[] { cboPort, cboPortRead })
        {
            cb.Items.Clear();
            foreach (var p in ports) cb.Items.Add(p);
        }
        cboPort.SelectedItem = "COM5";       // LS1+ control, as in the AQM app
        cboPortRead.SelectedItem = "COM4";   // LS1+ readings stream
    }

    private void SetStatus(string msg)
    {
        lstLog.Items.Add($"{DateTime.Now:HH:mm:ss.f}   {msg}");
        while (lstLog.Items.Count > 500) lstLog.Items.RemoveAt(0);
        lstLog.TopIndex = Math.Max(0, lstLog.Items.Count - 1);
        if (!msg.StartsWith("TX ") && !msg.StartsWith("SIM ")) lblHint.Text = msg;
    }

    private void ExportCsv()
    {
        if (_results.Count == 0) { SetStatus("No results to export."); return; }
        using var dlg = new SaveFileDialog
        {
            Filter = "CSV (*.csv)|*.csv",
            FileName = $"SpringTest_{DateTime.Now:yyyyMMdd_HHmm}.csv",
        };
        if (dlg.ShowDialog(this) != DialogResult.OK) return;

        var ci = CultureInfo.InvariantCulture;
        var sb = new StringBuilder();
        sb.AppendLine("Time,PartNumber,Family,FreeLength_in,Rate_lb_per_in,RateNominal,RateMin,RateMax,Deviation_pct,Result," +
                      "Point1_in,Point1_lbf,Point2_in,Point2_lbf");
        foreach (var r in _results)
        {
            var sp = r.Spec;
            string rate = r.RateLbPerIn?.ToString("0.0000", ci) ?? "";
            string dev = r.RateLbPerIn is double rd ? ((rd - sp.RateLbPerIn) / sp.RateLbPerIn * 100).ToString("0.00", ci) : "";
            string steps = string.Join(",", Enumerable.Range(0, 2).Select(k => r.Points != null && k < r.Points.Count
                ? $"{r.Points[k].PositionIn.ToString("0.0000", ci)},{r.Points[k].ForceLbf.ToString("0.0000", ci)}" : ","));
            sb.AppendLine(string.Join(",",
                r.Time.ToString("yyyy-MM-dd HH:mm:ss", ci), sp.PartNumber, sp.Family.ToString(),
                r.FreeLengthIn.ToString("0.000", ci), rate,
                sp.RateLbPerIn.ToString("0.000", ci), sp.RateMinLbPerIn.ToString("0.000", ci), sp.RateMaxLbPerIn.ToString("0.000", ci),
                dev, r.Pass ? "PASS" : "FAIL", steps));
        }
        try
        {
            File.WriteAllText(dlg.FileName, sb.ToString());
            SetStatus($"Exported {_results.Count} results to {dlg.FileName}");
        }
        catch (Exception ex)
        {
            SetStatus($"Export failed: {ex.Message}");
        }
    }

    private void Ui(Action a)
    {
        if (IsDisposed || Disposing) return;
        if (!InvokeRequired) { a(); return; }
        try { BeginInvoke(a); } catch (InvalidOperationException) { }   // also covers ObjectDisposedException
    }

