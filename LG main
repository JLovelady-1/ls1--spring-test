    private void ToggleLock()
    {
        if (_unlocked) { _unlocked = false; UpdateEnables(); SetStatus("Settings locked."); return; }
        if (AskPasscode() == SETTINGS_PASSCODE) { _unlocked = true; SetStatus("Settings unlocked."); }
        else SetStatus("Incorrect passcode.");
        UpdateEnables();
    }

    private string? AskPasscode()
    {
        using var dlg = new Form
        {
            Text = "Unlock settings", FormBorderStyle = FormBorderStyle.FixedDialog, StartPosition = FormStartPosition.CenterParent,
            ClientSize = new Size(320, 140), MaximizeBox = false, MinimizeBox = false, BackColor = CARD, ForeColor = INK,
            Font = new Font("Segoe UI", 9.5f), ShowInTaskbar = false,
        };
        var lbl = new Label { Text = "Enter passcode:", Location = new Point(16, 16), AutoSize = true, ForeColor = TEXT_MID };
        var tb = new TextBox { Location = new Point(16, 42), Width = 288, UseSystemPasswordChar = true, BackColor = CARD_HI, ForeColor = INK, BorderStyle = BorderStyle.FixedSingle };
        var ok = new Button { Text = "Unlock", DialogResult = DialogResult.OK, Location = new Point(144, 90), Size = new Size(76, 30), FlatStyle = FlatStyle.Flat, BackColor = ACCENT_FILL, ForeColor = DARK_TEXT };
        var cancel = new Button { Text = "Cancel", DialogResult = DialogResult.Cancel, Location = new Point(228, 90), Size = new Size(76, 30), FlatStyle = FlatStyle.Flat, BackColor = CARD_HI, ForeColor = INK };
        dlg.Controls.AddRange(new Control[] { lbl, tb, ok, cancel });
        dlg.AcceptButton = ok;
        dlg.CancelButton = cancel;
        return dlg.ShowDialog(this) == DialogResult.OK ? tb.Text : null;
    }

    private double PreloadPreviewN(SpringSpec s)
    {
        if (s.Family == SpringFamily.Trim) return (double)numTrimPreload.Value;
        double max = (double)numPreload.Value;
        if (!chkAutoPreload.Checked) return max;
        return Math.Clamp(s.LoadNomLbf * SpringSpec.N_PER_LBF * 0.05, Math.Min(0.1, max), max);
    }

    private void UpdateReturnText()
    {
        decimal v = numReturnTo.Value;
        btnReturn.Text = v == 0 ? "⟲   RETURN\nTO ZERO" : $"⟲   RETURN\nTO {v:0.##} mm";
        btnReturn.Invalidate();
    }

    private void ShowPage(int idx)
    {
        for (int i = 0; i < _pages.Length; i++) _pages[i].Visible = i == idx;
        for (int i = 0; i < _navBtns.Count; i++)
        {
            bool on = i == idx;
            _navBtns[i].Style(on ? CARD_HI : SIDEBAR, on ? CARD_HI : SIDEBAR, on ? INK : TEXT_MID, 0);
            _navBtns[i].Font = new Font("Segoe UI", 9.5f, on ? FontStyle.Bold : FontStyle.Regular);
        }
        _navMarker.Top = 88 + idx * 42;
    }

